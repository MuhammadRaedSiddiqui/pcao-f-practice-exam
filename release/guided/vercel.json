{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:guided:hosted",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/settings/",
      "destination": "/index.html"
    },
    {
      "source": "/history",
      "destination": "/index.html"
    },
    {
      "source": "/history/",
      "destination": "/index.html"
    },
    {
      "source": "/guided",
      "destination": "/index.html"
    },
    {
      "source": "/guided/",
      "destination": "/index.html"
    },
    {
      "source": "/guided/session/:sessionId",
      "destination": "/index.html"
    },
    {
      "source": "/guided/session/:sessionId/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/guided/intermediate-1.0.0.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/guided/intermediate-1.1.0.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
