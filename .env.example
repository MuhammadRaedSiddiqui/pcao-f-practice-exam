# Copy to .env.local. Never place service-role/secret keys in VITE_ variables.
VITE_ACCOUNT_HISTORY_ENABLED=false
# Recovery is enabled by default for configured accounts. Set false to disable it.
VITE_PASSWORD_RECOVERY_ENABLED=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PostHog browser project token only. Never use a personal API key here.
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_ANALYTICS_ENVIRONMENT=development
